				<div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-slate-800 rotate-45 border-l border-b border-indigo-500/30"></div>
			</div>
		</a>

		<hr class="border-slate-800/50 mx-2" />

		<a href="/forge" class="group relative flex items-center justify-center w-12 h-12 rounded-xl bg-slate-800 border border-slate-700 hover:border-emerald-400 text-slate-400 hover:text-emerald-400 transition-all hover:scale-105">
			<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 00-1 1v1a2 2 0 11-4 0v-1a1 1 0 00-1-1H7a1 1 0 01-1-1v-3a1 1 0 011-1h1a2 2 0 100-4H7a1 1 0 01-1-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" /></svg>
			<div class="absolute left-16 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-200 pointer-events-none">
				<div class="bg-slate-800 text-emerald-400 px-3 py-2 rounded-lg shadow-2xl border border-emerald-500/30 min-w-[120px] whitespace-nowrap">
					<p class="text-[10px] font-black uppercase tracking-widest">SGA Forge</p>
					<p class="text-[8px] text-slate-400 font-bold uppercase mt-1">Custom Builds</p>
				</div>
				<div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-slate-800 rotate-45 border-l border-b border-emerald-500/30"></div>
			</div>
		</a>

		<a href="/store" class="group relative flex items-center justify-center w-12 h-12 rounded-xl bg-slate-800 border border-slate-700 hover:border-slate-100 text-slate-400 hover:text-slate-100 transition-all hover:scale-105">
			<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
			<div class="absolute left-16 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-200 pointer-events-none">
				<div class="bg-slate-800 text-slate-100 px-3 py-2 rounded-lg shadow-2xl border border-slate-100/20 min-w-[120px] whitespace-nowrap">
					<p class="text-[10px] font-black uppercase tracking-widest">Provisions</p>
					<p class="text-[8px] text-slate-400 font-bold uppercase mt-1">Inventory Store</p>
				</div>
				<div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-slate-800 rotate-45 border-l border-b border-slate-100/20"></div>
			</div>
		</a>

		<a href="/booking" class="group relative flex items-center justify-center w-12 h-12 rounded-xl bg-slate-800 border border-slate-700 hover:border-purple-400 text-slate-400 hover:text-purple-400 transition-all hover:scale-105">
			<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
			<div class="absolute left-16 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-200 pointer-events-none">
				<div class="bg-slate-800 text-purple-400 px-3 py-2 rounded-lg shadow-2xl border border-purple-500/30 min-w-[120px] whitespace-nowrap">
					<p class="text-[10px] font-black uppercase tracking-widest">Concierge</p>
					<p class="text-[8px] text-slate-400 font-bold uppercase mt-1">SGA Maintenance</p>
