				<div class="bg-slate-800 text-indigo-400 px-3 py-2 rounded-lg shadow-2xl border border-indigo-500/30 min-w-[120px] whitespace-nowrap">
					<p class="text-[10px] font-black uppercase tracking-widest">Nexus Hub</p>
