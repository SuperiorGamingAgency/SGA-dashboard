	<div id="dashboard" class="hidden grid grid-cols-1 md:grid-cols-2 gap-4 animate-in fade-in slide-in-from-bottom-4 duration-700">
		<div class="bg-slate-900/50 border border-slate-800 p-6 rounded-2xl">
			<span class="text-orange-500 text-[10px] font-black tracking-widest uppercase italic">System Environment</span>
			<h2 id="os-description" class="text-xl font-bold mt-1 text-white uppercase italic">Detecting OS...</h2>
			<p id="os-details" class="text-[10px] font-mono mt-2 text-slate-500 uppercase tracking-tighter">Initializing Identity...</p>
		</div>
		<div id="stats-grid" class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-4"></div>
		<div class="md:col-span-2 flex justify-between items-center px-2 mt-4 border-t border-slate-800 pt-4">
			<p class="text-[10px] font-mono text-slate-500 uppercase tracking-widest">Verified SGA Data Stream</p>
			<p id="last-updated" class="text-[10px] font-mono text-slate-500 italic uppercase">SYNCING...</p>
		</div>
	</div>
</div>

<script>
	import { supabase } from '../lib/supabase';

	const sgaLog = (msg, data = null) => {
		const time = new Date().toLocaleTimeString();
		console.log(`%c[SGA DIALINK] ${time} - ${msg}`, "color: #f97316; font-weight: bold;", data || "");
	};

	document.addEventListener('DOMContentLoaded', async () => {
		const lockScreen = document.getElementById('lock-screen');
		const dashboard = document.getElementById('dashboard');
		const statsGrid = document.getElementById('stats-grid');
		const osDesc = document.getElementById('os-description');
		const osDetails = document.getElementById('os-details');
		const lastUpdated = document.getElementById('last-updated');
		const loginBtn = document.getElementById('login-btn');
		const userProfile = document.getElementById('user-profile');
		const userEmailDisplay = document.getElementById('user-email-display');
		const logoutBtn = document.getElementById('logout-btn');

		const componentCards = {}; // Stores { id: { type, index } }
		let lastPacketTime = Date.now();

		const { data: { session } } = await supabase.auth.getSession();
		const urlParams = new URLSearchParams(window.location.search);
		const isSyncRequest = urlParams.get('sync') === 'true';

		if (session) {
			sgaLog("Session Verified.", session.user.email);
			loginBtn?.classList.add('hidden');
			userProfile?.classList.remove('hidden');
			userProfile?.classList.add('flex');
			userEmailDisplay.innerText = session.user.email.substring(0, 1).toUpperCase();

			const currentUser = session.user.id;

			// 1. DISCOVERY & INITIALIZATION
			const { data: rig } = await supabase.from('rigs').select('*').eq('user_id', currentUser).single();

			if (rig) {
				osDesc.innerText = rig.os_name || "Windows Rig";
				osDetails.innerText = "Kernel Verified | System Stable";

				const { data: components } = await supabase.from('components').select('*').eq('rig_id', rig.id);

				if (components) {
					sgaLog(`Rig found. Building ${components.length} cards.`);
					components.forEach(comp => {
						if (comp.type !== 'OS') createHardwareCard(comp);
					});

					lockScreen.classList.add('hidden');
					dashboard.classList.remove('hidden');
				}
			}

			// Handshake logic
			if (isSyncRequest) {
				const performHandshake = async () => {
					try {
						const response = await fetch(`http://127.0.0.1:54321/auth?access=${session.access_token}&refresh=${session.refresh_token}`);
						if (response.ok) sgaLog("Local handshake successful.");
					} catch (err) { setTimeout(performHandshake, 2000); }
				};
				performHandshake();
			}

			// 2. WATCHDOG TIMER
			setInterval(() => {
				const silenceDuration = Date.now() - lastPacketTime;
				if (silenceDuration > 15000 && !dashboard.classList.contains('hidden')) {
					sgaLog("WATCHDOG: Stream loss detected.");
					lockScreen.classList.remove('hidden');
					lockScreen.classList.add('flex');
					dashboard.classList.add('hidden');
				}
			}, 5000);

			// 3. LIVE MONITORING
			supabase.channel('sga-live')
				.on('postgres_changes', {
					event: 'INSERT',
					schema: 'public',
					table: 'telemetry',
					filter: `user_id=eq.${currentUser}`
				}, (payload) => {
					const telemetry = payload.new;
					lastPacketTime = Date.now();

					if (dashboard.classList.contains('hidden')) {
						lockScreen.classList.add('hidden');
						dashboard.classList.remove('hidden');
					}

					const targetId = telemetry.component_id;

					if (targetId && componentCards[targetId]) {
						const type = componentCards[targetId].type;
						updateSpecificCard(targetId, telemetry.load_percent, telemetry.temp_celsius, type);
					}
					else {
						updateLegacyConsolidated(telemetry);
					}

					if (lastUpdated) lastUpdated.innerText = `SYNC: ${new Date().toLocaleTimeString()}`;
				})
				.subscribe();
		}

		function createHardwareCard(info) {
			if (document.getElementById(`card-${info.id}`)) return;

			const card = document.createElement('div');
			card.id = `card-${info.id}`;
			card.className = "bg-slate-900 border border-slate-800 p-6 rounded-2xl relative overflow-hidden group hover:border-orange-500/50 transition-all";

			const loadLabelText = info.type === 'DISK' ? 'Occupied' : 'Load';

			// Display VRAM next to GPU name if it exists
			const subTitle = info.vram_info ? `<span class="text-slate-500 text-[10px] ml-2 font-mono">[${info.vram_info}]</span>` : '';

			card.innerHTML = `
             <div class="flex justify-between items-start mb-4">
                 <span class="text-orange-500 text-[10px] font-black tracking-widest uppercase italic">${info.type}</span>
                 <span class="text-slate-700 text-[8px] font-mono">IDX: ${info.slot_index || 0}</span>
             </div>
             <h2 class="text-lg font-bold text-white leading-tight italic uppercase">
                ${info.model_name} ${subTitle}
             </h2>
             <div class="mt-6 bg-slate-800 h-1 rounded-full overflow-hidden">
                 <div id="bar-${info.id}" class="bg-orange-500 h-full w-0 transition-all duration-1000 shadow-[0_0_10px_#f97316]"></div>
             </div>
             <div class="flex justify-between mt-3 font-mono text-[9px] text-slate-500 uppercase">
                 <span>${loadLabelText}: <b class="text-white" id="load-${info.id}">N/A</b></span>
                 <span>Temp: <b class="text-white" id="temp-${info.id}">N/A</b></span>
             </div>
          `;
			statsGrid.appendChild(card);
			componentCards[info.id] = { type: info.type, index: info.slot_index || 0 };
		}

		function updateSpecificCard(id, load, temp, type) {
			const bar = document.getElementById(`bar-${id}`);
			const loadLabel = document.getElementById(`load-${id}`);
			const tempLabel = document.getElementById(`temp-${id}`);

			if (bar && load !== null) bar.style.width = `${load}%`;
			if (loadLabel && load !== null) loadLabel.innerText = `${Math.round(load)}%`;

			if (tempLabel) {
				if ((type === 'CPU' || type === 'GPU') && temp > 0) {
					tempLabel.innerText = `${Math.round(temp)}°C`;
				} else {
					tempLabel.innerText = 'N/A';
				}
			}
		}

		function updateLegacyConsolidated(telemetry) {
			Object.keys(componentCards).forEach(id => {
				const card = componentCards[id];
				if (card.type === 'CPU') updateSpecificCard(id, telemetry.cpu_load, telemetry.cpu_temp, 'CPU');
				if (card.type === 'RAM') updateSpecificCard(id, telemetry.ram_load, 0, 'RAM');
				if (card.type === 'GPU' && card.index === 0) updateSpecificCard(id, telemetry.gpu_load, telemetry.gpu_temp, 'GPU');
			});
		}

		logoutBtn?.addEventListener('click', async () => {
			await supabase.auth.signOut();
			window.location.reload();
		});
	});
</script>

<style is:global>
	@keyframes move-mesh { 0% { transform: translate(0, 0) scale(1); } 50% { transform: translate(15%, 10%) scale(1.1); } 100% { transform: translate(0, 0) scale(1); } }
	.animate-mesh-fast { animation: move-mesh 10s infinite alternate ease-in-out; }
	::-webkit-scrollbar { width: 0px; }
</style>
</body>
</html>