---
// index.astro - SGA Tech-Concierge Dashboard (MASTER EDITION)
import '../styles/global.css';
---

<html lang="en">
<head>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200..1000&display=swap" rel="stylesheet">
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<title>SGA Audit | Cloud Intelligence</title>
</head>
<body class="text-slate-100 font-sans min-h-screen p-4 md:p-12 overflow-x-hidden">

<div class="fixed inset-0 -z-10 overflow-hidden bg-[#020617]">
	<div class="absolute -top-[10%] -left-[10%] w-[70%] h-[70%] bg-orange-500/10 blur-[120px] rounded-full animate-mesh"></div>
	<div class="absolute -bottom-[10%] -right-[10%] w-[60%] h-[60%] bg-blue-500/10 blur-[120px] rounded-full animate-mesh" style="animation-delay: -4s;"></div>
</div>

<aside class="fixed left-6 top-1/2 -translate-y-1/2 z-[100] hidden lg:flex flex-col bg-slate-900/90 backdrop-blur-xl border border-slate-800 p-3 rounded-2xl shadow-[0_0_30px_rgba(0,0,0,0.5)]">
	<div class="flex flex-col gap-5 max-h-[80vh] overflow-y-visible">

		<a href="/" class="group relative flex items-center justify-center w-12 h-12 rounded-xl bg-orange-500 text-black shadow-[0_0_15px_rgba(249,115,22,0.3)] transition-all hover:scale-105">
			<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
			<div class="absolute left-16 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-200 pointer-events-none text-black">
				<div class="bg-orange-500 px-3 py-2 rounded-lg shadow-2xl border border-orange-400/50 whitespace-nowrap">
					<p class="text-[10px] font-black uppercase tracking-widest">Tactical Stats</p>
					<p class="text-[8px] font-bold opacity-70 uppercase leading-none mt-1">Live Telemetry</p>
				</div>
				<div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-orange-500 rotate-45"></div>
			</div>
		</a>

		<a href="/rig-manifest" class="group relative flex items-center justify-center w-12 h-12 rounded-xl bg-slate-800 border border-slate-700 hover:border-blue-400 text-slate-400 hover:text-blue-400 transition-all hover:scale-105">
			<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>
			<div class="absolute left-16 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-200 pointer-events-none">
				<div class="bg-slate-800 text-blue-400 px-3 py-2 rounded-lg shadow-2xl border border-blue-500/30 min-w-[120px] whitespace-nowrap">
					<p class="text-[10px] font-black uppercase tracking-widest">Rig Manifest</p>
					<p class="text-[8px] text-slate-400 font-bold uppercase mt-1">Identity & Specs</p>
				</div>
				<div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-slate-800 rotate-45 border-l border-b border-blue-500/30"></div>
