---
// src/pages/access.astro - SGA Identity Protocol (FAST SUBTLE MESH | OVERCLOCKED ORANGE)
import '../styles/global.css';
---

<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200..1000&family=JetBrains+Mono:wght@100..800&display=swap" rel="stylesheet">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SGA | Security Uplink</title>
</head>
<body class="text-slate-100 font-sans min-h-screen flex items-center justify-center p-4 overflow-hidden">

<div class="fixed inset-0 -z-10 overflow-hidden bg-[#020617]">
    <div class="absolute -top-[20%] -left-[20%] w-[120%] h-[120%] bg-orange-500/10 blur-[120px] rounded-full animate-mesh-fast"></div>
    <div class="absolute -bottom-[20%] -right-[20%] w-[110%] h-[110%] bg-blue-500/10 blur-[120px] rounded-full animate-mesh-fast" style="animation-delay: -2s;"></div>
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#ffffff 0.5px, transparent 0.5px); background-size: 40px 40px;"></div>
</div>

<div class="w-full max-w-[360px] bg-slate-950/60 border border-slate-800/80 p-8 rounded-[2.5rem] backdrop-blur-3xl shadow-2xl border-t-orange-500/20 relative animate-in fade-in zoom-in duration-700">

    <div class="flex justify-between items-center mb-10">
        <div class="flex items-center gap-2">
            <div class="w-2.5 h-2.5 rounded-full bg-orange-400 animate-pulse shadow-[0_0_12px_#fb923c]"></div>
            <span class="text-[10px] font-mono text-slate-500 uppercase tracking-[0.4em]">Secure_Link</span>
        </div>
        <span class="text-[10px] font-mono text-slate-700 uppercase italic leading-none">v1.2.0</span>
    </div>

    <div class="text-center mb-10">
        <h1 style="font-family: 'Cairo', sans-serif;" class="text-3xl font-black uppercase tracking-tighter text-white italic leading-none">
            SGA <span class="text-orange-400 font-light italic">ACCESS</span>
        </h1>
    </div>

    <div class="flex bg-slate-950/90 p-1.5 rounded-2xl border border-slate-800/50 mb-10 w-full shadow-inner">
        <button id="toggle-login" class="flex-1 py-4.5 text-[11px] font-black uppercase rounded-xl bg-orange-400 text-black transition-all shadow-[0_0_25px_rgba(251,146,60,0.5)]">
            Login
        </button>
        <button id="toggle-signup" class="flex-1 py-4.5 text-[11px] font-black uppercase rounded-xl text-slate-500 hover:text-white transition-all">
            Register
        </button>
    </div>

    <form id="access-form" class="space-y-5">
        <div class="relative group">
            <div class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-600 group-focus-within:text-orange-400 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2m8-10a4 4 0 100-8 4 4 0 000 8z"/></svg>
            </div>
            <input type="email" id="email" required
                   class="w-full bg-slate-950/50 border border-slate-800 py-4.5 pl-12 pr-4 rounded-2xl text-white focus:border-orange-400/50 outline-none transition-all placeholder:text-slate-500 font-mono text-[11px] uppercase tracking-widest"
                   placeholder="OPERATOR_ID">
        </div>

        <div class="relative group">
            <div class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-600 group-focus-within:text-orange-400 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            <input type="password" id="password" required
                   class="w-full bg-slate-950/50 border border-slate-800 py-4.5 pl-12 pr-4 rounded-2xl text-white focus:border-orange-400/50 outline-none transition-all placeholder:text-slate-500 font-mono text-[11px]"
                   placeholder="ACCESS_KEY">
        </div>

        <button type="submit" id="submit-btn" class="w-full py-5 bg-orange-400 text-black font-black rounded-2xl text-[12px] hover:brightness-110 active:scale-[0.96] transition-all shadow-[0_15px_50px_rgba(251,146,60,0.3)] mt-4">
            Initialize Uplink
        </button>
    </form>

    <div id="status-msg" class="mt-6 text-center text-[9px] font-mono uppercase p-3 rounded-xl border border-transparent hidden animate-in fade-in zoom-in duration-200"></div>

    <div class="mt-10 pt-8 border-t border-slate-800/40 text-center">
        <p class="text-slate-700 text-[8px] font-bold uppercase tracking-[0.5em] leading-relaxed">
            Superior Gaming Agency <br/>
            <span class="text-slate-600 opacity-30 italic font-mono uppercase tracking-widest">Handshake_Protocol_Active</span>
        </p>
    </div>
</div>

<script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('access-form');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    const submitBtn = document.getElementById('submit-btn');
    const statusMsg = document.getElementById('status-msg');

    const loginToggle = document.getElementById('toggle-login');
    const signupToggle = document.getElementById('toggle-signup');

    let isLogin = true;

    // --- WATERFALL LOGIC: CAPTURE RETURN URL ---
    const urlParams = new URLSearchParams(window.location.search);
    const returnTo = urlParams.get('returnTo') || '/';

    const setMode = (toLogin) => {
        isLogin = toLogin;
        statusMsg.classList.add('hidden');
        const activeClass = "flex-1 py-4.5 text-[11px] font-black uppercase rounded-xl bg-orange-400 text-black transition-all shadow-[0_0_25px_rgba(251,146,60,0.5)]";
        const inactiveClass = "flex-1 py-4.5 text-[11px] font-black uppercase rounded-xl text-slate-500 hover:text-white transition-all";

        if (isLogin) {
            loginToggle.className = activeClass;
            signupToggle.className = inactiveClass;
            submitBtn.innerText = "Initialize Uplink";
        } else {
            signupToggle.className = activeClass;
            loginToggle.className = inactiveClass;
            submitBtn.innerText = "Register Identity";
        }
    };

    loginToggle.addEventListener('click', () => setMode(true));
    signupToggle.addEventListener('click', () => setMode(false));

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerText = isLogin ? "LINKING..." : "REGISTERING...";
        statusMsg.classList.add('hidden');

        const email = emailInput.value;
        const password = passwordInput.value;

        let result;
        if (isLogin) {
            result = await supabase.auth.signInWithPassword({ email, password });
        } else {
            result = await supabase.auth.signUp({ email, password });
        }

        if (result.error) {
            statusMsg.innerText = `ERR: ${result.error.message}`;
            statusMsg.className = "mt-4 text-center text-[9px] font-mono uppercase p-3 rounded-xl bg-red-500/5 text-red-500 border border-red-500/20 block w-full";
            submitBtn.disabled = false;
            submitBtn.innerText = isLogin ? "Initialize Uplink" : "Register Identity";
        } else {
            if (!isLogin) {
                statusMsg.innerText = "ID Sent. Verify via Email link.";
                statusMsg.className = "mt-4 text-center text-[9px] font-mono uppercase p-3 rounded-xl bg-emerald-500/5 text-emerald-500 border border-emerald-500/20 block w-full";
            } else {
                // --- WATERFALL LOGIC: REDIRECT TO CAPTURED URL ---
                window.location.href = returnTo;
            }
        }
    });
</script>

<style is:global>
    @keyframes move-mesh-fast {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(30%, 15%) scale(1.15); }
        100% { transform: translate(0, 0) scale(1); }
    }
    .animate-mesh-fast {
        animation: move-mesh-fast 6s infinite alternate ease-in-out;
    }
    .py-4\.5 {
        padding-top: 1.125rem;
        padding-bottom: 1.125rem;
    }
</style>
</body>
</html>