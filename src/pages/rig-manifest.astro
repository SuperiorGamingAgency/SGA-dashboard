---
// rig-manifest.astro - SGA Rig Intelligence (MASTER COMMAND v1.8.9.1)
import '../styles/global.css';
---

<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200..1000&display=swap" rel="stylesheet">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>SGA Manifest | Core Identity</title>
</head>
<body class="text-slate-100 font-sans min-h-screen p-4 md:p-12 overflow-x-hidden pb-24 lg:pb-12 bg-[#020617]">

<div class="fixed inset-0 -z-10 overflow-hidden bg-[#020617]">
    <div class="absolute -top-[20%] -left-[20%] w-[120%] h-[120%] bg-blue-600/10 blur-[120px] rounded-full animate-mesh-fast"></div>
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#ffffff 0.5px, transparent 0.5px); background-size: 40px 40px;"></div>
</div>

<aside class="fixed bottom-0 left-0 w-full lg:w-auto lg:left-6 lg:top-1/2 lg:-translate-y-1/2 z-[100] bg-slate-900/90 backdrop-blur-xl border-t lg:border border-slate-800 p-3 lg:rounded-2xl shadow-[0_-10px_30px_rgba(0,0,0,0.5)] lg:shadow-[0_0_30px_rgba(0,0,0,0.5)] h-fit">
    <div class="flex flex-row lg:flex-col gap-4 md:gap-5 w-full justify-around lg:justify-start items-center h-fit overflow-x-auto lg:overflow-visible no-scrollbar px-2 lg:px-0">

        <a href="/" class="group relative flex flex-shrink-0 items-center justify-center w-11 h-11 md:w-12 md:h-12 rounded-xl bg-slate-800 border border-slate-700 hover:border-orange-500 text-slate-400 hover:text-orange-500 transition-all hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            <div class="hidden lg:block absolute left-16 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-200 pointer-events-none text-black z-[200]">
                <div class="bg-orange-500 px-3 py-2 rounded-lg shadow-2xl border border-orange-400/50 whitespace-nowrap">
                    <p class="text-[10px] font-black uppercase tracking-widest">Tactical Stats</p>
                    <p class="text-[8px] font-bold opacity-70 uppercase leading-none mt-1">Live Telemetry</p>
                </div>
                <div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-orange-500 rotate-45"></div>
            </div>
        </a>

        <a href="/rig-manifest" class="group relative flex flex-shrink-0 items-center justify-center w-11 h-11 md:w-12 md:h-12 rounded-xl bg-blue-600 text-white shadow-[0_0_20px_rgba(37,99,235,0.4)] transition-all hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>
            <div class="hidden lg:block absolute left-16 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-200 pointer-events-none text-white z-[200]">
                <div class="bg-blue-600 px-3 py-2 rounded-lg shadow-2xl border border-blue-400/50 whitespace-nowrap">
                    <p class="text-[10px] font-black uppercase tracking-widest">Rig Manifest</p>
                    <p class="text-[8px] font-bold opacity-70 uppercase leading-none mt-1">Hardware ID</p>
                </div>
                <div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-blue-600 rotate-45"></div>
            </div>
        </a>

        <a href="/nexus" class="group relative flex flex-shrink-0 items-center justify-center w-11 h-11 md:w-12 md:h-12 rounded-xl bg-slate-800 border border-slate-700 hover:border-indigo-400 text-slate-400 hover:text-indigo-400 transition-all hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
            <div class="hidden lg:block absolute left-16 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-200 pointer-events-none text-white z-[200]">
                <div class="bg-indigo-600 px-3 py-2 rounded-lg shadow-2xl border border-indigo-400/50 whitespace-nowrap">
                    <p class="text-[10px] font-black uppercase tracking-widest">Nexus Hub</p>
                    <p class="text-[8px] font-bold opacity-70 uppercase leading-none mt-1">SGA Collaboration</p>
                </div>
                <div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-indigo-600 rotate-45"></div>
            </div>
        </a>
        <div class="w-[1px] h-8 lg:w-8 lg:h-[1px] bg-slate-800/50 mx-1 lg:mx-0"></div>
        <a href="/forge" class="group relative flex flex-shrink-0 items-center justify-center w-11 h-11 md:w-12 md:h-12 rounded-xl bg-slate-800 border border-slate-700 hover:border-emerald-400 text-slate-400 hover:text-emerald-400 transition-all hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 00-1 1v1a2 2 0 11-4 0v-1a1 1 0 00-1-1H7a1 1 0 01-1-1v-3a1 1 0 011-1h1a2 2 0 100-4H7a1 1 0 01-1-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" /></svg>
            <div class="hidden lg:block absolute left-16 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-200 pointer-events-none text-white z-[200]">
                <div class="bg-emerald-600 px-3 py-2 rounded-lg shadow-2xl border border-emerald-400/50 whitespace-nowrap">
                    <p class="text-[10px] font-black uppercase tracking-widest">The Forge</p>
                    <p class="text-[8px] font-bold opacity-70 uppercase leading-none mt-1">Custom Assembly</p>
                </div>
                <div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-emerald-600 rotate-45"></div>
            </div>
        </a>
        <a href="/store" class="group relative flex flex-shrink-0 items-center justify-center w-11 h-11 md:w-12 md:h-12 rounded-xl bg-slate-800 border border-slate-700 hover:border-slate-100 text-slate-400 hover:text-slate-100 transition-all hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
            <div class="hidden lg:block absolute left-16 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-200 pointer-events-none text-white z-[200]">
                <div class="bg-slate-700 px-3 py-2 rounded-lg shadow-2xl border border-slate-600 whitespace-nowrap">
                    <p class="text-[10px] font-black uppercase tracking-widest">SGA Store</p>
                    <p class="text-[8px] font-bold opacity-70 uppercase leading-none mt-1">Retail Access</p>
                </div>
                <div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-slate-700 rotate-45"></div>
            </div>
        </a>
        <a href="/booking" class="group relative flex flex-shrink-0 items-center justify-center w-11 h-11 md:w-12 md:h-12 rounded-xl bg-slate-800 border border-slate-700 hover:border-purple-400 text-slate-400 hover:text-purple-400 transition-all hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            <div class="hidden lg:block absolute left-16 invisible opacity-0 group-hover:visible group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-200 pointer-events-none text-white z-[200]">
                <div class="bg-purple-600 px-3 py-2 rounded-lg shadow-2xl border border-purple-400/50 whitespace-nowrap">
                    <p class="text-[10px] font-black uppercase tracking-widest">Consulting</p>
                    <p class="text-[8px] font-bold opacity-70 uppercase leading-none mt-1">Book Session</p>
                </div>
                <div class="absolute top-1/2 -left-1 -translate-y-1/2 w-2 h-2 bg-purple-600 rotate-45"></div>
            </div>
        </a>
    </div>
</aside>

<div class="max-w-4xl mx-auto lg:pl-20">
    <header class="flex flex-col md:flex-row justify-between items-center mb-12 border-b border-slate-800 pb-8">
        <div>
            <h1 style="font-family: 'Cairo', sans-serif;" class="text-2xl tracking-tighter text-white font-black uppercase">
                SUPERIOR <span class="font-light opacity-70">GAMING</span> AGENCY
            </h1>
            <p class="text-slate-500 text-sm font-mono uppercase tracking-widest" id="rig-id-display">v1.1.0 | CLOUD SYNC ACTIVE</p>
        </div>

        <nav class="flex items-center gap-4 mt-6 md:mt-0">
            <div class="flex items-center gap-1 bg-slate-900/50 p-1 rounded-xl border border-slate-800">
                <a href="https://wa.me/36707330072" target="_blank" title="WhatsApp" class="p-2 text-slate-500 hover:text-emerald-500 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.06 3.978l-1.127 4.117 4.212-1.105a7.86 7.86 0 0 0 3.79.975h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/></svg>
                </a>
                <a href="https://instagram.com/superiorgamingagency" target="_blank" title="Instagram" class="p-2 text-slate-500 hover:text-pink-500 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"/></svg>
                </a>
                <a href="https://t.me/Superiordanial" target="_blank" title="Telegram" class="p-2 text-slate-500 hover:text-sky-500 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zm5.56 8.16l-1.93 9.1c-.14.64-.52.79-1.06.49l-2.95-2.17-1.42 1.37c-.16.16-.29.29-.6.29l.2-3 5.46-4.93c.24-.22-.05-.34-.37-.13l-6.74 4.25-2.9-.91c-.63-.2-1.1-.52-.13-.88l11.31-4.36c.53-.2 1-.12.86.87z"/></svg>
                </a>
                <a href="https://github.com/SuperiorGamingAgency" target="_blank" title="GitHub" class="p-2 text-slate-500 hover:text-white transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
                </a>
                <a href="mailto:superiorgamingagency@gmail.com" title="Email Support" class="p-2 text-slate-500 hover:text-orange-500 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </a>

                <div id="auth-container" class="flex items-center border-l border-slate-800 ml-1 pl-1">
                    <a href="/about" title="About SGA" class="p-2 text-slate-500 hover:text-orange-500 transition-all group relative">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                    </a>
                    <a href="/signin" id="login-btn" class="p-2 text-slate-500 hover:text-orange-500 transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </a>
                    <div id="user-profile" class="hidden items-center gap-2 px-2 border-l border-slate-800/50">
                        <span id="user-email-display" class="text-[9px] font-bold uppercase tracking-tight text-slate-500">...</span>
                        <button id="logout-btn" class="p-1 text-slate-600 hover:text-red-500 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-16">
        <div class="md:col-span-4 flex flex-col items-center">
            <div class="relative group w-48 h-48 rounded-3xl bg-slate-900 border-2 border-dashed border-slate-800 hover:border-blue-500 transition-all p-2 overflow-hidden shadow-2xl flex items-center justify-center">
                <div id="avatar-placeholder" class="absolute inset-0 flex flex-col items-center justify-center text-slate-700 group-hover:text-blue-500/50 transition-colors">
                    <svg xmlns="https://www.w3.org/2000/svg" class="w-20 h-20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>
                </div>
                <img id="rig-avatar" src="" class="hidden w-full h-full object-cover rounded-2xl group-hover:scale-105 transition-transform duration-500" />
                <input type="file" id="avatar-upload" class="hidden" accept="image/*" />
                <label for="avatar-upload" class="absolute inset-0 z-10 flex items-center justify-center bg-blue-600/80 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer backdrop-blur-sm"><span class="text-[10px] font-black uppercase text-white tracking-widest">Update Core Identity</span></label>
            </div>
            <h2 id="display-nickname" class="mt-4 text-xl font-black italic uppercase text-blue-500 tracking-tighter">Initializing...</h2>
        </div>
        <div class="md:col-span-8 space-y-6">
            <div class="flex flex-col md:flex-row gap-4">
                <input id="input-nickname" type="text" placeholder="Designate Rig Name" class="flex-1 bg-slate-900/50 border border-slate-800 p-4 rounded-xl focus:border-blue-500 outline-none font-bold uppercase text-white transition-all" />
                <button id="save-profile" class="px-8 py-4 bg-blue-600 text-white font-black uppercase text-[10px] tracking-widest rounded-xl hover:bg-blue-500 transition-all shadow-lg active:scale-95">Sync Identity</button>
            </div>
            <textarea id="input-story" placeholder="The story of this build..." class="w-full h-40 bg-slate-900/50 border border-slate-800 p-4 rounded-xl focus:border-blue-500 outline-none text-sm text-slate-400 leading-relaxed no-scrollbar"></textarea>
        </div>
    </section>

    <section id="tactical-analyzer" class="bg-blue-600/5 border border-blue-600/20 p-6 rounded-3xl mb-12 flex flex-col md:flex-row items-center gap-6 transition-all duration-500">
        <div class="relative flex-shrink-0">
            <div class="absolute inset-0 bg-blue-600/20 blur-xl rounded-full animate-pulse"></div>
            <div class="relative w-16 h-16 rounded-2xl bg-slate-900 border border-blue-600/30 flex items-center justify-center">
                <svg xmlns="https://www.w3.org/2000/svg" class="w-8 h-8 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.724 10.339 8.75 11.858 5.026-1.52 8.75-6.266 8.75-11.858q0-1.895-.598-3.748A11.959 11.959 0 0112 2.714z" /></svg>
            </div>
        </div>
        <div class="text-center md:text-left flex-grow">
            <h3 class="text-blue-500 font-black uppercase tracking-[0.3em] text-xs mb-1">SGA Guardian Engine</h3>
            <p id="analysis-msg" class="text-lg text-white font-medium italic leading-tight uppercase tracking-tighter">Initializing Diagnostic Assessment...</p>
        </div>
    </section>

    <div id="manifest-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-16"></div>

    <section class="space-y-8 mb-24">
        <div class="flex flex-col md:flex-row justify-between items-end gap-6">
            <div>
                <span id="hardware-label" class="text-blue-500 text-[10px] font-black tracking-widest uppercase italic">SYSTEM TELEMETRY</span>
                <h2 class="text-3xl font-black italic uppercase tracking-tighter">Mission Analytics</h2>
                <p class="text-[9px] text-slate-600 uppercase font-bold mt-1">Scroll to Zoom • Drag to Pan • Hover anywhere for intel</p>
            </div>

            <div class="flex flex-col gap-3 items-end w-full md:w-auto">
                <div id="time-selector" class="grid grid-cols-5 gap-1 bg-slate-900/50 p-1.5 rounded-2xl border border-slate-800 w-full">
                    <button data-hours="24" class="time-btn active px-2 py-2 text-[8px] font-black uppercase rounded-lg transition-all text-white bg-blue-600">24H</button>
                    <button data-hours="72" class="time-btn px-2 py-2 text-[8px] font-black uppercase rounded-lg transition-all text-slate-500 hover:bg-slate-800">3D</button>
                    <button data-hours="168" class="time-btn px-2 py-2 text-[8px] font-black uppercase rounded-lg transition-all text-slate-500 hover:bg-slate-800">7D</button>
                    <button data-hours="360" class="time-btn px-2 py-2 text-[8px] font-black uppercase rounded-lg transition-all text-slate-500 hover:bg-slate-800">15D</button>
                    <button data-hours="720" class="time-btn px-2 py-2 text-[8px] font-black uppercase rounded-lg transition-all text-slate-500 hover:bg-slate-800">30D</button>
                </div>

                <div class="flex flex-wrap items-center gap-4 w-full">
                    <div id="hw-selector" class="flex flex-wrap gap-2 bg-slate-900/50 p-1.5 rounded-2xl border border-slate-800 flex-grow"></div>
                    <button id="reset-zoom" class="px-4 py-2 text-[9px] font-black uppercase rounded-lg transition-all text-slate-400 hover:bg-slate-800 border border-slate-800 whitespace-nowrap">Reset View</button>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-6">
            <div class="bg-slate-900/40 border border-slate-800 p-6 rounded-3xl backdrop-blur-md relative h-[350px]">
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-4">Thermal Timeline (°C)</p>
                <div class="h-[280px] cursor-crosshair"><canvas id="tempChart"></canvas></div>
            </div>
            <div class="bg-slate-900/40 border border-slate-800 p-6 rounded-3xl backdrop-blur-md relative h-[350px]">
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-4">Workload Distribution (%)</p>
                <div class="h-[280px] cursor-crosshair"><canvas id="loadChart"></canvas></div>
            </div>
        </div>
    </section>
</div>

<script>
    import { supabase } from '../lib/supabase';
    import Chart from 'chart.js/auto';
    import 'chartjs-adapter-date-fns';
    import zoomPlugin from 'chartjs-plugin-zoom';

    Chart.register(zoomPlugin);

    let metrics = { cpu: { load: 0, temp: 0 }, gpu: { load: 0, temp: 0 } };
    let componentMap = {};
    let selectedComponentId = null;
    let selectedHours = 24;
    let tempChart, loadChart;

    document.addEventListener('DOMContentLoaded', async () => {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return window.location.href = '/signin';
        const userId = session.user.id;

        const loginBtn = document.getElementById('login-btn');
        const userProfile = document.getElementById('user-profile');
        const emailDisplay = document.getElementById('user-email-display');

        if (session) {
            loginBtn.classList.add('hidden');
            userProfile.classList.remove('hidden');
            userProfile.classList.add('flex'); // Ensure layout is correct
            emailDisplay.innerText = session.user.email.substring(0, 1).toUpperCase();
        }

        initCharts();

        // 1. FETCH RIG & IDENTITY
        const { data: rig } = await supabase.from('rigs').select('*').eq('user_id', userId).single();
        if (rig) {
            document.getElementById('display-nickname').innerText = rig.nickname || "CORE UNNAMED";
            document.getElementById('input-nickname').value = rig.nickname || "";
            document.getElementById('input-story').value = rig.story || "";
            if (rig.avatar_url) {
                const img = document.getElementById('rig-avatar');
                img.src = rig.avatar_url;
                img.classList.remove('hidden');
                document.getElementById('avatar-placeholder').classList.add('hidden');
            }

            // FETCH COMPONENTS
            const { data: components } = await supabase.from('components').select('*').eq('rig_id', rig.id);
            if (components) {
                const selector = document.getElementById('hw-selector');

                // Track the first one to select it
                let firstId = null;

                components.forEach((comp) => {
                    if (comp.type === 'OS') return;
                    componentMap[comp.id] = { type: comp.type };
                    createHardwareCard(comp);

                    if (comp.type !== 'DISK') {
                        if (!firstId) firstId = comp.id;

                        const btn = document.createElement('button');
                        const shortName = comp.model_name.replace('NVIDIA GeForce ', '').replace('Intel(R) Core(TM) ', '').split(' @')[0];

                        // We check if this is the one we should mark as active
                        const shouldBeActive = (!selectedComponentId && comp.id === firstId) || (selectedComponentId === comp.id);

                        if (shouldBeActive) {
                            selectedComponentId = comp.id;
                            document.getElementById('hardware-label').innerText = comp.model_name;
                        }

                        btn.className = `hw-select-btn px-4 py-2 text-[9px] font-black uppercase rounded-lg transition-all flex items-center gap-2 ${shouldBeActive ? 'bg-blue-600 text-white' : 'text-slate-500 hover:bg-slate-800'}`;
                        btn.innerHTML = `<span class="opacity-40 text-[7px]">${comp.type}</span><span>${shortName}</span>`;

                        btn.onclick = () => {
                            selectedComponentId = comp.id;
                            document.querySelectorAll('.hw-select-btn').forEach(b => {
                                b.classList.remove('bg-blue-600', 'text-white');
                                b.classList.add('text-slate-500', 'hover:bg-slate-800');
                            });
                            btn.classList.add('bg-blue-600', 'text-white');
                            btn.classList.remove('text-slate-500', 'hover:bg-slate-800');
                            document.getElementById('hardware-label').innerText = comp.model_name;
                            loadHistoricalData(userId);
                        };
                        selector.appendChild(btn);
                    }
                });

                // TRIGGER HISTORY FETCH NOW THAT ID IS SET
                if (selectedComponentId) {
                    loadHistoricalData(userId);
                }
            }
        }

        // 2. LIVE UPDATES
        supabase.channel('rig-telemetry').on('postgres_changes', {
            event: 'INSERT', schema: 'public', table: 'telemetry', filter: `user_id=eq.${userId}`
        }, (payload) => {
            const data = payload.new;
            const config = componentMap[data.component_id];
            if (config) {
                updateCardUI(data.component_id, data.load_percent, data.temp_celsius);
                if (config.type === 'CPU') { metrics.cpu.load = data.load_percent; metrics.cpu.temp = data.temp_celsius; }
                if (config.type === 'GPU') { metrics.gpu.load = data.load_percent; metrics.gpu.temp = data.temp_celsius; }
                runSgaAnalysis();

                if (data.component_id === selectedComponentId) {
                    const time = new Date(data.recorded_at);
                    tempChart.data.datasets[0].data.push({ x: time, y: data.temp_celsius });
                    loadChart.data.datasets[0].data.push({ x: time, y: data.load_percent });
                    if (selectedHours <= 24 && tempChart.data.datasets[0].data.length > 200) {
                        tempChart.data.datasets[0].data.shift();
                        loadChart.data.datasets[0].data.shift();
                    }
                    tempChart.update('none');
                    loadChart.update('none');
                }
            }
        }).subscribe();

        // TIME SELECTOR LOGIC
        document.querySelectorAll('.time-btn').forEach(btn => {
            btn.onclick = () => {
                selectedHours = parseInt(btn.getAttribute('data-hours'));
                document.querySelectorAll('.time-btn').forEach(b => {
                    b.classList.remove('bg-blue-600', 'text-white');
                    b.classList.add('text-slate-500', 'hover:bg-slate-800');
                });
                btn.classList.add('bg-blue-600', 'text-white');
                btn.classList.remove('text-slate-500', 'hover:bg-slate-800');
                loadHistoricalData(userId);
            };
        });

        // AVATAR UPLOAD
        document.getElementById('avatar-upload').addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const fileName = `${userId}/avatar-${Date.now()}`;

            // CLEANUP PREVIOUS AVATAR
            const { data: rig } = await supabase.from('rigs').select('avatar_url').eq('user_id', userId).single();
            if (rig?.avatar_url) {
                try {
                    const oldPath = rig.avatar_url.split('/rig-avatars/')[1];
                    if (oldPath) {
                        await supabase.storage.from('rig-avatars').remove([oldPath]);
                    }
                } catch (err) {
                    console.error("Storage cleanup failed:", err);
                }
            }

            const { data, error } = await supabase.storage.from('rig-avatars').upload(fileName, file, { upsert: true });
            if (!error) {
                const { data: { publicUrl } } = supabase.storage.from('rig-avatars').getPublicUrl(fileName);
                await supabase.from('rigs').update({ avatar_url: publicUrl }).eq('user_id', userId);
                window.location.reload();
            }
        });

        // SYNC PROFILE
        document.getElementById('save-profile').addEventListener('click', async () => {
            const nickname = document.getElementById('input-nickname').value;
            const story = document.getElementById('input-story').value;
            await supabase.from('rigs').update({ nickname, story }).eq('user_id', userId);
            window.location.reload();
        });

        document.getElementById('reset-zoom').onclick = () => {
            tempChart.resetZoom();
            loadChart.resetZoom();
        };

        const logoutBtn = document.getElementById('logout-btn');
        logoutBtn?.addEventListener('click', async () => {
            await supabase.auth.signOut();
            window.location.href = '/signin';
        });
    });

    function initCharts() {
        const baseOptions = {
            responsive: true,
            maintainAspectRatio: false,
            parsing: false,
            normalized: true,
            spanGaps: true,
            animation: { duration: 0 },
            interaction: { mode: 'index', intersect: false },
            scales: {
                x: {
                    type: 'time',
                    time: { displayFormats: { hour: 'HH:mm', day: 'MMM d' } },
                    grid: { display: false },
                    ticks: { color: '#475569', font: { size: 8 }, maxRotation: 0 }
                },
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(255,255,255,0.02)', drawBorder: false },
                    ticks: { color: '#475569', font: { size: 8 }, padding: 10 }
                }
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0f172a',
                    padding: 10,
                    displayColors: false,
                    borderColor: 'rgba(255,255,255,0.1)',
                    borderWidth: 1
                },
                zoom: {
                    pan: { enabled: true, mode: 'x', threshold: 10 },
                    zoom: { wheel: { enabled: true }, pinch: { enabled: true }, mode: 'x' }
                }
            },
            elements: {
                point: { radius: 0, hoverRadius: 4 },
                line: { borderCapStyle: 'round', borderJoinStyle: 'round' }
            }
        };

        const createGradient = (ctx, color) => {
            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, `${color}22`);
            gradient.addColorStop(1, `${color}00`);
            return gradient;
        };

        const tempCtx = document.getElementById('tempChart').getContext('2d');
        tempChart = new Chart(tempCtx, {
            type: 'line',
            data: {
                datasets: [{
                    borderColor: '#ef4444',
                    backgroundColor: createGradient(tempCtx, '#ef4444'),
                    fill: true,
                    data: [],
                    tension: 0.3,
                    borderWidth: 2,
                }]
            },
            options: baseOptions
        });

        const loadCtx = document.getElementById('loadChart').getContext('2d');
        loadChart = new Chart(loadCtx, {
            type: 'line',
            data: {
                datasets: [{
                    borderColor: '#3b82f6',
                    backgroundColor: createGradient(loadCtx, '#3b82f6'),
                    fill: true,
                    data: [],
                    tension: 0.3,
                    borderWidth: 2,
                }]
            },
            options: baseOptions
        });
    }

    async function loadHistoricalData(userId) {
        if (!selectedComponentId) return;
        const cutoff = new Date(Date.now() - selectedHours * 60 * 60 * 1000).toISOString();

        const { data, error } = await supabase
            .from('telemetry')
            .select('load_percent, temp_celsius, recorded_at')
            .eq('component_id', selectedComponentId)
            .eq('user_id', userId)
            .gt('recorded_at', cutoff)
            .order('recorded_at', { ascending: true });

        if (data) {
            const unit = selectedHours > 48 ? 'day' : 'hour';
            tempChart.options.scales.x.time.unit = unit;
            loadChart.options.scales.x.time.unit = unit;

            tempChart.data.datasets[0].data = data.map(d => ({ x: new Date(d.recorded_at), y: d.temp_celsius }));
            loadChart.data.datasets[0].data = data.map(d => ({ x: new Date(d.recorded_at), y: d.load_percent }));

            tempChart.update();
            loadChart.update();
        }
    }

    function createHardwareCard(comp) {
        const grid = document.getElementById('manifest-grid');
        const card = document.createElement('div');
        card.id = `card-${comp.id}`;
        card.className = "bg-slate-900/40 border border-slate-800 p-5 rounded-2xl transition-all hover:border-blue-500/30";
        card.innerHTML = `<div class="flex justify-between mb-2"><span class="text-[9px] text-slate-500 uppercase font-black tracking-widest">${comp.type}</span></div><h4 class="text-xs font-bold text-white uppercase italic truncate">${comp.model_name}${comp.vram_info ? `<span class="text-blue-500 ml-2">[${comp.vram_info}]</span>` : ''}</h4><div class="mt-4 bg-slate-800 h-1 rounded-full overflow-hidden"><div id="bar-${comp.id}" class="bg-blue-600 h-full w-0 transition-all duration-700"></div></div><div class="flex justify-between mt-3 text-[8px] font-mono text-slate-500 uppercase"><span>${comp.type === 'DISK' ? 'OCCUPIED' : 'LOAD'}: <b id="load-${comp.id}" class="text-white">--%</b></span><span>TEMP: <b id="temp-${comp.id}" class="text-white">--</b></span></div>`;
        grid.appendChild(card);
    }

    function updateCardUI(id, load, temp) {
        const bar = document.getElementById(`bar-${id}`);
        if (bar) bar.style.width = `${load}%`;
        const l = document.getElementById(`load-${id}`);
        if (l) l.innerText = `${Math.round(load)}%`;
        const t = document.getElementById(`temp-${id}`);
        if (t) t.innerText = temp > 0 ? `${Math.round(temp)}°C` : 'N/A';
    }

    function runSgaAnalysis() {
        const msg = document.getElementById('analysis-msg');
        let report = "SYSTEM OPTIMIZED. CORE PARAMETERS WITHIN NOMINAL RANGE.";
        if (metrics.cpu.temp > 88 || metrics.gpu.temp > 82) report = "CRITICAL: THERMAL LIMIT EXCEEDED. COOLING ADVISED.";
        msg.innerText = report;
    }
</script>

<style is:global>
    @keyframes move-mesh { 0% { transform: translate(0, 0) scale(1); } 50% { transform: translate(8%, 4%) scale(1.05); } 100% { transform: translate(0, 0) scale(1); } }
    .animate-mesh-fast { animation: move-mesh 15s infinite alternate ease-in-out; }
    ::-webkit-scrollbar { width: 0px; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
</style>
</body>
</html>